{
  "name": "english-games-vocabulary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-content.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:prepare": "node scripts/prepare-content.mjs",
    "audio:generate": "node scripts/generate-audio.mjs",
    "content:manifest": "node scripts/manifest.mjs",
    "deploy:preview": "wrangler pages deploy dist --project-name english-games-vocabulary --branch preview",
    "deploy": "wrangler pages deploy dist --project-name english-games-vocabulary --branch main"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "lucide-react": "^0.468.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^4.1.11",
    "@playwright/test": "^1.58.2",
    "fake-indexeddb": "^6.0.0",
    "sharp": "^0.35.4",
    "kokoro-js": "^1.2.1",
    "@breezystack/lamejs": "^1.2.7",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-range-requests": "^7.3.0",
    "wrangler": "^4.0.0"
  },
  "overrides": { "sharp": "$sharp" }
}
